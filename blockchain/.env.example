# Only needed for public testnets / a real network. NOT needed for local development.
# Never commit the real .env file.

# Account that deploys the contract and becomes its admin (use a throwaway key on testnets)
DEPLOYER_PRIVATE_KEY=

# Address the backend will sign with (the "operator"). Required on non-local networks.
# On localhost the deploy script uses Hardhat account #1 automatically.
OPERATOR_ADDRESS=

SEPOLIA_RPC_URL=
BESU_RPC_URL=
