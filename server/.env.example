PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/symptomsync

JWT_SECRET=change-me
JWT_EXPIRE=7d

# 32-byte master key (64 hex chars) used to protect per-file encryption keys.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACK THIS UP. If it is lost, every encrypted medical record becomes unreadable.
# Never commit it. In production keep it in a secrets manager / KMS.
MASTER_KEY=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

GROQ_API_KEY=
