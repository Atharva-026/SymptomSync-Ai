PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/symptomsync

JWT_SECRET=change-me
JWT_EXPIRE=7d

# 32-byte master key (64 hex chars) used to protect per-file encryption keys.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACK THIS UP. If it is lost, every encrypted medical record becomes unreadable.
# Never commit it. In production keep it in a secrets manager / KMS.
MASTER_KEY=

# ---- Blockchain layer (optional) --------------------------------------------
# Leave BLOCKCHAIN_ENABLED=false and the app works exactly as before.
BLOCKCHAIN_ENABLED=false
# Local Hardhat node: http://127.0.0.1:8545 and chain id 31337
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Printed by `npm run deploy:local` in /blockchain
CONTRACT_ADDRESS=
# Key of the backend "operator" account. Locally: Hardhat account #1 (a public
# dev key - NEVER use it on a real network). Elsewhere: a dedicated, funded key
# kept in a secrets manager.
OPERATOR_PRIVATE_KEY=
# Secret that turns Mongo ids into the opaque ids stored on-chain (64 hex chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later breaks the link to everything already registered. Back it up.
CHAIN_ID_SALT=
# true = also write every file view/download to the chain's audit trail
# (free on a private Besu network; costs gas on public chains)
CHAIN_LOG_VIEWS=false

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

GROQ_API_KEY=
